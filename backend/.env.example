# Copy to backend/.env for local development. Never commit the real .env.
CODEBUD_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=codebud
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Optional, comma-separated. Defaults to *.
CORS_ORIGINS=
