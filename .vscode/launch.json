{
    // Run configurations for CodeBud. See docs/LOCAL_DEVELOPMENT.md.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend (Flask)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "program": "${workspaceFolder}/backend/app.py",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "windows": { "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe" },
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "App (Chrome, local API)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend/flutter_app",
            "deviceId": "chrome",
            "args": ["--dart-define=API_BASE_URL=http://127.0.0.1:5000"]
        },
        {
            "name": "App (Chrome, production API)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend/flutter_app",
            "deviceId": "chrome"
        }
    ],
    "compounds": [
        {
            "name": "Backend + App",
            "configurations": ["Backend (Flask)", "App (Chrome, local API)"]
        }
    ]
}
